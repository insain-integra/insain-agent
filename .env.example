# Скопируйте в .env и заполните значения. Файл .env в git не коммитится.
# docker compose подхватывает .env из корня репозитория для сервиса tg-bot.

# --- Обязательно для Telegram-бота ---
TELEGRAM_TOKEN=

# При запуске через docker compose CALC_API_URL задаётся в docker-compose.yml (http://calc-api:8001).
# Для локального запуска бота без Docker оставьте:
# CALC_API_URL=http://127.0.0.1:8001

# Ограничение доступа: список telegram user id через запятую (пусто = все)
# ALLOWED_USERS=

# --- LLM (один или несколько провайдеров по llm_provider / режиму) ---
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# AITUNNEL_API_KEY=
# AITUNNEL_BASE_URL=
# AITUNNEL_MODEL=
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# LLM_MODE=mixed
# GEMINI_MODEL=gemini-2.5-flash

# --- Агент ---
# AGENT_USE_ROUTER=true
# CHOICES_SEARCH_LIMIT=500

# --- Yandex Wiki (опционально) ---
# WIKI_OAUTH_TOKEN=
# WIKI_BASE_URL=
# WIKI_ORG_ID=
# WIKI_SLUGS=

# --- База знаний: локальный fallback ---
# KB_LOCAL_DIR=
# WIKI_FALLBACK_DIR=
# KB_REFRESH_HOURS=6

# --- calc_service (опционально; в образе обычно не нужен .env) ---
# SITE_URL=https://insain.ru
